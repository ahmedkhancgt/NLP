      "webhookId": "75d5053c-0489-4947-9bf4-148519bea790"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (\n    INSERT INTO customers (name, email, phone, country, language, marketing_opt_in)\n    VALUES ($1, lower(trim($2)), NULLIF($3, ''), NULLIF(upper(trim($4)), ''), $5, $6 = 'yes')\n    ON CONFLICT (email) DO UPDATE\n    SET name = EXCLUDED.name,\n        phone = COALESCE(EXCLUDED.phone, customers.phone),\n        country = COALESCE(EXCLUDED.country, customers.country),\n        language = EXCLUDED.language,\n        marketing_opt_in = EXCLUDED.marketing_opt_in\n    RETURNING id\n),\ni AS (\n    INSERT INTO customer_interests (customer_id, brand, reference, max_budget_usd, source)\n    SELECT c.id, trim($7), NULLIF(upper(trim($8)), ''), NULLIF($9, '')::NUMERIC, 'manual'\n    FROM c\n    WHERE trim($7) <> ''\n    ON CONFLICT (customer_id, lower(brand), lower(coalesce(reference, ''))) DO UPDATE\n    SET max_budget_usd = EXCLUDED.max_budget_usd\n)\nSELECT id AS customer_id FROM c;",
        "options": {
          "queryReplacement": "={{ [$json[\"Name\"], $json[\"Email\"], $json[\"Phone\"] ?? \"\", $json[\"Country\"] ?? \"\", $json[\"Language\"], $json[\"Agreed to marketing emails\"], $json[\"Interested brand\"] ?? \"\", $json[\"Interested reference\"] ?? \"\", String($json[\"Max budget USD\"] || \"\")] }}"
        }
      },
      "id": "32999d47-175c-47cc-b270-147fbd67dc98",
