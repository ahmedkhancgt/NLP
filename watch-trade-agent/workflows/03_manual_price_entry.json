      ],
      "webhookId": "4db9771b-8096-455f-ba4e-dcd4acafd548"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO market_prices\n    (source, external_id, seller, brand, reference, title, condition, box_papers,\n     price, currency, price_usd, country, url)\nVALUES\n    ($1, COALESCE(NULLIF($9, ''), md5(random()::TEXT)), NULLIF($2, ''), $3, upper(trim($4)),\n     'Entered by hand', $5,\n     CASE $6 WHEN 'yes' THEN TRUE WHEN 'no' THEN FALSE END,\n     $7::NUMERIC, upper(trim($8)),\n     ROUND($7::NUMERIC / (SELECT per_usd FROM fx_rates WHERE currency = upper(trim($8))), 2),\n     NULLIF(upper(trim($10)), ''),\n     CASE WHEN $9 LIKE 'http%' THEN $9 END)\nRETURNING id, reference, price_usd;",
        "options": {
          "queryReplacement": "={{ [$json[\"Source\"], $json[\"Seller or auction house\"] || \"\", $json[\"Brand\"], $json[\"Reference\"], $json[\"Condition\"], $json[\"Box and papers\"], $json[\"Price\"], $json[\"Currency\"], $json[\"Link or lot number\"] || \"\", $json[\"Country\"] || \"\"] }}"
        }
      },
      "id": "85789025-129e-49d5-a280-ddb28be509c4",
      "name": "Save price",
      "type": "n8n-nodes-base.postgres",
